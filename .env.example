# Chép file này thành .env rồi điền giá trị. Server tự đọc .env khi khởi động.

PORT=8787
# Địa chỉ web công khai, không có dấu / ở cuối. Dùng cho sitemap, robots và link quay lại sau khi thanh toán.
SITE_URL=http://localhost:8787
# Các email tự thành admin khi đăng ký/đăng nhập, phân tách bằng dấu phẩy
ADMIN_EMAILS=
# File SQLite
DB_PATH=data/app.db
# production: cookie Secure, tắt thanh toán giả lập, phục vụ bản build trong dist/ (npm start đã tự bật)
NODE_ENV=
# Đặt 1 khi chạy sau nginx/Cloudflare để lấy IP thật (giới hạn tần suất theo IP)
TRUST_PROXY=

# PayOS (https://my.payos.vn): Kênh thanh toán > Thông tin tích hợp. Để trống = thanh toán giả lập khi phát triển.
# Webhook khai báo trên PayOS: <SITE_URL>/api/billing/payos-webhook
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Giá gói Premium (VND)
PRICE_MONTH_VND=29000
PRICE_YEAR_VND=249000

# Thống kê theo ngày ở trang admin dùng múi giờ này (giờ Việt Nam = 7)
STATS_UTC_OFFSET_HOURS=7

# Quảng cáo Google AdSense (đọc lúc build, cần build lại sau khi đổi). Để trống = hiện banner Premium của chính web.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
